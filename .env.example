TINYFISH_API_KEY=
GEMINI_API_KEY=

# Optional
# WM_MODEL=gemini-3.5-flash-lite      # explore, compile, edit, repair
# WM_FAST_MODEL=gemini-3.5-flash-lite # extract steps
# WM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.1-flash-lite-preview
#                                # tried in order when a model is out of quota, overloaded or retired
# WM_DATA_DIR=./data                 # where workflows, runs and traces are stored
# STORAGE=sqlite                     # sqlite (default, data/workflow-memory.db) or files
# WM_OWNER=local                     # whose workflows the CLI and MCP server use (a Clerk user id for a hosted user's)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY= # web app sign-in (Clerk); both unset = single-user web app
# CLERK_SECRET_KEY=
# WM_DEBUG=1                         # log raw TinyFish responses to stderr
