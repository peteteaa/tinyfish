                "price",
                "features"
              ]
            }
          }
        },
        "required": [
          "plans"
        ]
      }
    }
  ],
  "output": "{{steps.extract_pricing_plans}}",
  "source": {
    "goal": "Get the pricing plans on linear.app/pricing: each plan's name, price per user and key features.",
